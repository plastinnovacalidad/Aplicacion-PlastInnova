# Plantilla de configuración. Copia este archivo como ".env" y ajusta las
# rutas según el computador donde se instale la aplicación.

# Carpetas donde el sistema busca fotos de circuitos, separadas por "|"
CARPETAS_FOTOS=C:\ruta\a\tu\carpeta1|C:\ruta\a\tu\carpeta2

# Carpeta donde viven las fotos de "forma de cableado" del módulo Valores y
# Cableado (una sola carpeta, no una lista — es un módulo distinto al de las
# fotos de circuitos de arriba). Se puede dejar vacía para usar el valor por
# defecto de siempre. Si la carpeta no existe todavía, se crea sola.
CARPETA_FOTOS_CABLEADO=C:\ruta\a\tu\carpeta\de\fotos\de\cableado

# Archivos CSV que se importan una sola vez (al crear referencias de metrología
# que aún no existan) para cargar planos y cotas iniciales
RUTAS_CSV_PATH=C:\ruta\a\Rutas.csv
COTAS_CSV_PATH=C:\ruta\a\cotas.csv

# Puerto donde corre el servidor
PORT=3000

# Números de WhatsApp autorizados a usar el bot (registro de entrada/salida),
# con el nombre que se les muestra. Formato: numero:nombre, separados por "|"
WHATSAPP_NUMEROS=numero1@lid:Nombre Uno|numero2@c.us:Nombre Dos

# Número de WhatsApp del administrador: recibe el resumen diario y es el
# único que puede usar el comando "cerrar <numero>". Debe ser uno de los
# números listados arriba en WHATSAPP_NUMEROS.
WHATSAPP_ADMIN_NUMERO=numero1@lid

# Mensaje que se envía al cerrar el registro del día (puede usar {nombre})
WHATSAPP_MENSAJE_SALIDA=¡Buen trabajo {nombre}! Descansa y nos vemos mañana. 👋

# Modo consulta del bot (Roadmap Bot WhatsApp, punto 8 — TERCERA revisión):
# rama de PRUEBA que usa Ollama (local, en vez de Gemini en la nube) para que
# el bot entienda preguntas escritas distinto a los comandos fijos, en vez de
# solo reglas/palabras clave. A diferencia de Gemini, Ollama NO necesita
# ninguna llave/API key — corre en tu propia red o equipo.
#
# OLLAMA_BASE_URL: dirección donde corre Ollama. Se puede dejar vacía para
# usar el valor por defecto "http://localhost:11434" (Ollama en el mismo
# equipo donde corre este servidor). Si más adelante mueves Ollama a un
# computador aparte ("un servidor" dedicado), cambia esto a la IP de esa
# máquina, por ejemplo http://192.168.1.50:11434 — no hace falta tocar nada
# más del código.
OLLAMA_BASE_URL=

# Modelo de Ollama usado para interpretar la pregunta del modo consulta. Debe
# coincidir EXACTO con el nombre que aparece en "ollama list" en tu máquina
# (incluye el tag, ej. ":7b"). Se puede dejar vacío para usar el valor por
# defecto ("qwen2.5:7b", el modelo usado en esta prueba).
MODELO_IA_MODO_CONSULTA=

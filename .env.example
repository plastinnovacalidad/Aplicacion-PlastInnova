# Plantilla de configuración. Copia este archivo como ".env" y ajusta las
# rutas según el computador donde se instale la aplicación.

# Carpetas donde el sistema busca fotos de circuitos, separadas por "|"
CARPETAS_FOTOS=C:\ruta\a\tu\carpeta1|C:\ruta\a\tu\carpeta2

# Archivos CSV que se importan una sola vez (al crear referencias de metrología
# que aún no existan) para cargar planos y cotas iniciales
RUTAS_CSV_PATH=C:\ruta\a\Rutas.csv
COTAS_CSV_PATH=C:\ruta\a\cotas.csv

# Puerto donde corre el servidor
PORT=3000

# Números de WhatsApp autorizados a usar el bot (registro de entrada/salida),
# con el nombre que se les muestra. Formato: numero:nombre, separados por "|"
WHATSAPP_NUMEROS=numero1@lid:Nombre Uno|numero2@c.us:Nombre Dos

# Número de WhatsApp del administrador: recibe el resumen diario y es el
# único que puede usar el comando "cerrar <numero>". Debe ser uno de los
# números listados arriba en WHATSAPP_NUMEROS.
WHATSAPP_ADMIN_NUMERO=numero1@lid

# Mensaje que se envía al cerrar el registro del día (puede usar {nombre})
WHATSAPP_MENSAJE_SALIDA=¡Buen trabajo {nombre}! Descansa y nos vemos mañana. 👋
